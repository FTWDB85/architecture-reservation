
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "round-dust-009d",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "architecture-reservation-db",
      "database_id": "021a103f-3fd1-4947-a981-5ccdbe536209"
    }
  ]
}
